# Copiez ce fichier en .env et adaptez les valeurs pour votre environnement.
# Ne commitez JAMAIS le fichier .env réel dans Git.

# Clé secrète Django — générez-en une nouvelle pour la production :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Obligatoire en production (DEBUG=False). Laissez cette valeur de développement uniquement en local.
SECRET_KEY=django-immogest-secret-key-changez-en-production

# Passez à False en production
DEBUG=True

# Domaines/IP autorisés à servir l'application, séparés par des virgules
# Exemple production : monsite.com,www.monsite.com
# En production, listez explicitement vos domaines (le caractère * est refusé).
ALLOWED_HOSTS=*

# Sécurité HTTPS (à activer en production, une fois le HTTPS configuré)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- Base de données ---
# Vide en local = SQLite automatique. En production, votre hébergeur vous
# fournira une URL de ce type (ne pas mettre de guillemets) :
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/nom_de_la_base

# --- Emails (notifications : demandes de contact, réservations, accès locataire) ---
# Laisser EMAIL_USE_SMTP=False en local : les emails s'affichent dans la console.
EMAIL_USE_SMTP=False
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@votredomaine.com

# --- Stockage des médias (S3, Cloudinary...) — à activer quand vous aurez un compte ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-3
AWS_S3_CUSTOM_DOMAIN=

# Données partagées entre tous les comptes de gestion (True) ou isolées par compte (False)
DONNEES_PARTAGEES=True

# Origines autorisées pour un frontend hébergé séparément (inutile : l'app React est servie sur /app/)
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com

# Django sert les photos téléversées (mettre False si vous utilisez S3 / un autre stockage)
SERVE_MEDIA=True

# --- Notifications au gestionnaire : email + WhatsApp -------------------------
# Adresse publique du site (liens « Ouvrir dans ImmoGest » dans les messages)
SITE_URL=http://localhost:8000

# Adresse qui reçoit les alertes si le compte du gestionnaire n'a pas d'email (défaut : EMAIL_HOST_USER)
# NOTIFICATIONS_EMAIL_DEFAUT=

# WhatsApp : cloud (Meta WhatsApp Business) | twilio | console (journal, pour tester) | vide = désactivé
WHATSAPP_PROVIDER=console

# -- Fournisseur « cloud » (Meta) : https://developers.facebook.com/docs/whatsapp/cloud-api
# Meta impose un MODÈLE approuvé pour écrire à quelqu'un qui ne vous a pas écrit depuis 24 h :
# créez un modèle « utilitaire » avec une seule variable {{1}} puis donnez son nom ici.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=fr

# -- Fournisseur « twilio »
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
